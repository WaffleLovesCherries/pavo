---
import Layout from '../layouts/Layout.astro';
import ChalkTray from '../components/ChalkTray.astro';
import CabinetGuide from '../components/CabinetGuide.astro';
import TemperingGuide from '../components/TemperingGuide.astro';
import { CHOCOLATES, TEMPERING_STYLE } from '../config/tempering';

const cabinet = TEMPERING_STYLE === 'cabinet';
---
<Layout title="Templado de chocolate" description="Las temperaturas de templado del chocolate negro, con leche, blanco, ruby, caramelizado y la manteca de cacao, con la curva de cada uno.">
  <article class:list={['sheet', 'paper', cabinet ? 'paper--cabinet' : 'paper--board']}>
    <div class="face paper-face">
      <a class="back" href={import.meta.env.BASE_URL}>&larr; Volver a todas las recetas</a>
      <div class="content">
        {cabinet ? <CabinetGuide /> : <TemperingGuide />}
      </div>
    </div>
    {!cabinet && <ChalkTray colors={CHOCOLATES.map((c) => c.chalk)} />}
  </article>
</Layout>

<style>
  .sheet { max-width: 1040px; margin: 0 auto; }
  .back {
    display: inline-block;
    margin: 26px 0 0 40px;
    padding-bottom: 2px;
    border-bottom: 1px dashed currentColor;
  }
  .content { padding: 22px 40px 44px; }

  /* Chalk on the board, ink on the wood. */
  .paper--board .back { color: var(--chalk-dim); font: 500 17px/1 var(--chalk-font); }
  .paper--board .back:hover { color: var(--chalk); }
  .paper--cabinet .back { color: var(--cream); font: 500 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; padding-bottom: 4px; }
  .paper--cabinet .back:hover { color: #fff; }

  @media (max-width: 820px) {
    .back { margin-left: 20px; }
    .content { padding: 18px 20px 32px; }
  }
</style>

---
/**
 * The tempering guide's own URL: the index with the guide's drawer already open, so a
 * reload or a shared link shows the same thing as pulling the handle and clicking the drawer.
 */
import Layout from '../layouts/Layout.astro';
import RecipeIndex from '../components/RecipeIndex.astro';
---
<Layout title="Templado de chocolate" description="Las temperaturas de templado del chocolate negro, con leche, blanco, ruby, caramelizado y la manteca de cacao, con la curva de cada uno.">
  <RecipeIndex open="templado" />
</Layout>

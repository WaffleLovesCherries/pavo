---
/**
 * A recipe's own URL: the index with that recipe's drawer already open, so a reload or a
 * shared link shows the same thing as clicking the card. The title and description are
 * the recipe's, for the tab and the link preview.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeIndex from '../../components/RecipeIndex.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const d = recipe.data;
---
<Layout title={d.name} description={`${d.name}: ${d.profile}. ${d.prep}.`}>
  <RecipeIndex open={recipe.id} />
</Layout>

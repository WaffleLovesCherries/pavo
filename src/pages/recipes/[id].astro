---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeSheet from '../../components/RecipeSheet.astro';
import { paperFor } from '../../lib/paper';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const d = recipe.data;
const paper = paperFor(d.name);
---
<Layout title={d.name} description={`${d.name}: ${d.profile}. ${d.prep}.`}>
  <article class:list={['sheet', 'paper', `paper--${paper.style}`]} style={`--tilt:${paper.tilt / 2}deg`}>
    <div class="face paper-face">
      <a class="back" href={import.meta.env.BASE_URL}>&larr; Volver a todas las recetas</a>
      <div class="content">
        <RecipeSheet recipe={recipe} />
      </div>
    </div>
  </article>
</Layout>

<style>
  .sheet { max-width: 960px; margin: 0 auto; }
  .back {
    display: inline-block;
    margin: calc(28px + var(--paper-top, 0px)) 0 0 calc(40px + var(--paper-left, 0px));
    color: var(--brown);
    font: 500 12px/1 var(--sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    border-bottom: 1px dashed var(--sand-dark);
    padding-bottom: 4px;
  }
  .back:hover { color: var(--ink); border-color: var(--brown); }
  .content { padding: 26px 40px 44px calc(40px + var(--paper-left, 0px)); }

  @media (max-width: 820px) {
    .back { margin-left: calc(20px + var(--paper-left, 0px)); }
    .content { padding: 20px 20px 32px calc(20px + var(--paper-left, 0px)); }
  }
</style>

---
/**
 * A brass bail handle screwed into the underside of the site header, with no label:
 * an easter egg. Pulling it slides the tempering drawer (the slot) out from behind the
 * header; pulling again slides it back in. It can also be dragged: the drawer follows the
 * hand down or up, and let go it locks open or shut, whichever is nearer or the way it was
 * flicked. Closed by default and kept out of the tab order while closed. `label` is only
 * for assistive tech.
 *
 * Behind the same handle hides a second drawer, in the `secret` slot: when something in
 * the first raises an `unlock` event (the keyhole, src/components/Keyhole.astro), the
 * drawer slides shut, the second is put in its place and it slides open again. Shut
 * again, the first is back behind the handle, and the second has to be unlocked anew.
 */
interface Props {
  label?: string;
}
const { label = 'Guía de templado' } = Astro.props;
---
<div class="drop" data-tempering-drop>
  <div class="window" id="tempering-drop" data-drop-body>
    <div class="pad" data-drop-drawer>
      <div data-drop-card="main"><slot /></div>
      <div data-drop-card="secret" hidden><slot name="secret" /></div>
    </div>
  </div>
  <button type="button" class="pull" data-drop-toggle aria-expanded="false" aria-controls="tempering-drop" aria-label={label}>
    <svg class="bail" viewBox="0 0 72 24" width="72" height="24" aria-hidden="true">
      <defs>
        <linearGradient id="brass-bail" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#F1D99F" />
          <stop offset=".45" stop-color="#C79A45" />
          <stop offset=".62" stop-color="#9C7430" />
          <stop offset="1" stop-color="#E4C47C" />
        </linearGradient>
      </defs>
      <path class="bail-shadow" d="M10 3v8q0 10 10 10h32q10 0 10-10V3" />
      <path class="bail-bar" d="M10 3v8q0 10 10 10h32q10 0 10-10V3" />
    </svg>
  </button>
</div>

<script>
  import { grip } from '../lib/grip';
  import { lockWay } from '../lib/pull';

  const root = document.querySelector<HTMLElement>('[data-tempering-drop]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-drop-toggle]');
  const win = root?.querySelector<HTMLElement>('[data-drop-body]');
  const drawer = root?.querySelector<HTMLElement>('[data-drop-drawer]');
  if (root && toggle && win && drawer) {
    /** How far the handle moves before a press counts as a pull rather than a click. */
    const SLACK = 4;
    /** A hand still for this long, in ms, before letting go has stopped pulling. */
    const STILL = 80;
    /** The slide takes this long (see --slide); the fallback if no transitionend arrives. */
    const SLIDE = 750;
    const isOpen = () => root.classList.contains('is-open');
    // The window's open height is the drawer's own height, measured so it can be animated in pixels.
    const fit = () => win.style.setProperty('--h', `${drawer.offsetHeight}px`);

    // Which drawer is behind the handle: the main one, or the secret one once unlocked.
    const cards = [...drawer.querySelectorAll<HTMLElement>('[data-drop-card]')];
    const showCard = (name: string) => { for (const c of cards) c.hidden = c.dataset.dropCard !== name; };
    const showing = () => cards.find((c) => !c.hidden)?.dataset.dropCard ?? 'main';
    // Runs `fn` once the drawer has finished sliding (or straight away without a transition).
    let slide = 0;
    const afterSlide = (fn: () => void) => {
      const token = ++slide;
      let done = false;
      const finish = () => {
        if (done || token !== slide) return;
        done = true;
        win.removeEventListener('transitionend', onEnd);
        fn();
      };
      const onEnd = (e: TransitionEvent) => { if (e.target === win && e.propertyName === 'height') finish(); };
      win.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, SLIDE + 50);
    };

    const set = (open: boolean) => {
      if (open) fit();
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      win.inert = !open;
      // The secret drawer only comes out once per unlocking: shut, the main one is back behind the handle.
      if (!open && showing() !== 'main') afterSlide(() => { if (!isOpen()) showCard('main'); });
    };
    set(false);
    new ResizeObserver(() => { if (isOpen()) fit(); }).observe(drawer);

    // Unlocked: shut, swap, open again.
    root.addEventListener('unlock', () => {
      set(false);
      afterSlide(() => { showCard('secret'); set(true); });
    });

    // A handle that was pulled and let go has already locked the drawer; the click that follows must not toggle it back.
    let pulled = false;
    toggle.addEventListener('click', () => {
      if (pulled) return;
      set(!isOpen());
    });

    // The pointer pulling the handle; a second finger on it is ignored (src/lib/grip.ts).
    const holder = grip();
    toggle.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !holder.take(e.pointerId)) return;
      pulled = false;
      toggle.setPointerCapture(e.pointerId);
      fit();
      const full = drawer.offsetHeight;
      // From wherever the drawer is right now, mid-slide included; only up and down count.
      const from = win.getBoundingClientRect().height;
      const y0 = e.clientY;
      let last = { y: e.clientY, t: e.timeStamp };
      let speed = 0;
      let moved = false;

      const move = (m: PointerEvent) => {
        if (!holder.holds(m.pointerId)) return;
        const dy = m.clientY - y0;
        if (!moved && Math.abs(dy) < SLACK) return;
        if (!moved) {
          moved = true;
          root.classList.add('is-pulling');
        }
        win.style.height = `${Math.max(0, Math.min(full, from + dy))}px`;
        const dt = m.timeStamp - last.t;
        if (dt > 0) speed = (m.clientY - last.y) / dt * 1000;
        last = { y: m.clientY, t: m.timeStamp };
      };
      const drop = (u: PointerEvent) => {
        if (!holder.holds(u.pointerId)) return;
        holder.free(u.pointerId);
        toggle.removeEventListener('pointermove', move);
        toggle.removeEventListener('pointerup', drop);
        toggle.removeEventListener('pointercancel', drop);
        if (!moved) return;
        pulled = true;
        const open = lockWay(win.getBoundingClientRect().height, full, speed, u.timeStamp - last.t > STILL);
        // Back on the slide: the transition carries it the rest of the way from where it was let go.
        root.classList.remove('is-pulling');
        win.style.height = '';
        set(open);
      };
      toggle.addEventListener('pointermove', move);
      toggle.addEventListener('pointerup', drop);
      toggle.addEventListener('pointercancel', drop);
    });
  }
</script>

<style>
  .drop {
    --brass-light: #F1D99F;
    --brass: #C79A45;
    --brass-dark: #7A5A22;
    --slide: .7s cubic-bezier(.2, .8, .2, 1);
    max-width: 980px;
    /* Tucks up against the header's bottom edge (its margin is 40px / 24px on phones). */
    margin: -40px auto 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /*
   * Drawer and handle move as one piece. The drawer is pinned to the bottom of a clipped
   * window and the handle hangs right under that window, so wherever the window's bottom
   * edge is, the drawer's front and the handle are there together. Opening is only the
   * window growing from 0 to the drawer's height, in pixels, so nothing can drift.
   */
  .window {
    position: relative;
    width: calc(100% + 48px);
    height: 0;
    overflow: hidden;
    transition: height var(--slide);
  }
  .is-open .window { height: var(--h, 0px); }
  /* In the hand the window is wherever the hand holds it, at once. */
  .is-pulling .window { transition: none; }
  .pad {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 24px 0;
  }

  .pull {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* The handle is dragged up and down, so no page scroll starts from a finger on it. */
    touch-action: none;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, .45));
    transition: transform .15s ease;
  }
  .pull:active { transform: translateY(1px); }
  .is-pulling .pull { transform: none; cursor: grabbing; }
  .pull:focus-visible { outline: 2px dashed var(--accent-light); outline-offset: 6px; border-radius: 6px; }
  @media (hover: hover) {
    .pull:hover .plate, .pull:hover .bail { filter: brightness(1.08); }
  }

  /* The backplate: a small brass strip screwed on at both ends. */
  .plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 72px;
    padding: 4px 6px 5px;
    border-radius: 0 0 5px 5px;
    border: 1px solid var(--brass-dark);
    border-top: 0;
    background: linear-gradient(180deg, var(--brass-light), var(--brass) 45%, #A87C32 62%, #E0BE74);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .55), inset 0 -1px 0 rgba(0, 0, 0, .2);
  }
  .screw {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background:
      linear-gradient(35deg, transparent 44%, rgba(60, 40, 10, .7) 44% 56%, transparent 56%),
      radial-gradient(circle at 35% 30%, var(--brass-light), var(--brass) 55%, var(--brass-dark));
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .25), 0 1px 1px rgba(255, 255, 255, .4);
  }
  .screw + .screw { transform: rotate(50deg); }

  /* The bail: a curved brass bar hanging from two posts under the plate. */
  .bail { display: block; margin-top: -1px; overflow: visible; }
  .bail-shadow { fill: none; stroke: var(--brass-dark); stroke-width: 8; stroke-linecap: round; }
  .bail-bar { fill: none; stroke: url(#brass-bail); stroke-width: 5.5; stroke-linecap: round; }
  .post { fill: var(--brass); stroke: var(--brass-dark); stroke-width: 1; }

  @media (pointer: coarse) {
    .pull { padding: 0 10px 6px; }
  }
  @media (max-width: 720px) {
    .drop { margin: -24px auto 24px; }
    .window { width: calc(100% + 32px); }
    .pad { padding: 10px 16px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .window, .pull { transition: none; }
  }
</style>

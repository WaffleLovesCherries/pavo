---
/**
 * The index: header, the tempering drawer under it, the filter bar and the recipe grid,
 * with the viewer drawer that opens a recipe (or the guide, or the secret notes) over it
 * all. Every page is this same index; a recipe's own URL renders it with that recipe's
 * drawer already open (`open`), so a reload or a shared link lands on the same view.
 */
import { getCollection } from 'astro:content';
import SiteHeader from './SiteHeader.astro';
import RecipeCard from './RecipeCard.astro';
import RecipeSheet from './RecipeSheet.astro';
import RecipeViewer from './RecipeViewer.astro';
import CabinetCard from './CabinetCard.astro';
import CabinetGuide from './CabinetGuide.astro';
import SecretCard from './SecretCard.astro';
import SecretNotes from './SecretNotes.astro';
import TemperingCard from './TemperingCard.astro';
import TemperingDrop from './TemperingDrop.astro';
import TemperingGuide from './TemperingGuide.astro';
import { TEMPERING_STYLE } from '../config/tempering';
import { SECRETS } from '../config/secrets';
import { SITE } from '../config/site';
import { getCategory } from '../config/categories';
import { paperFor } from '../lib/paper';

interface Props {
  /** A recipe id or `templado`: open that in the viewer as the page loads. */
  open?: string;
}
const { open } = Astro.props;

const cabinet = TEMPERING_STYLE === 'cabinet';

const recipes = (await getCollection('recipes')).sort((a, b) => {
  const ta = a.data.lastMade?.getTime() ?? 0;
  const tb = b.data.lastMade?.getTime() ?? 0;
  return tb - ta || a.data.name.localeCompare(b.data.name);
});

const tagCounts = new Map<string, number>();
for (const r of recipes) for (const t of r.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const headerTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, SITE.headerTagCount)
  .map(([t]) => t);

/** What the viewer drawer needs to know about a recipe before cloning its sheet. */
function viewData(r: (typeof recipes)[number]) {
  const cat = getCategory(r.data.category);
  return {
    'data-recipe-view': r.id,
    'data-name': r.data.name,
    'data-eyebrow': r.data.kind ? `${cat.label} · ${r.data.kind}` : cat.label,
    'data-color': cat.color,
    'data-paper': paperFor(r.data.name).style,
  };
}
---
<SiteHeader tags={headerTags} />
<TemperingDrop>
  {cabinet ? <CabinetCard /> : <TemperingCard />}
  <SecretCard slot="secret" />
</TemperingDrop>

<div class="bar">
  <span class="count" data-count>{recipes.length} {recipes.length === 1 ? 'receta' : 'recetas'}</span>
  <span class="sort">Ordenadas por última elaboración</span>
</div>

<div class="grid" data-grid>
  {recipes.map((r) => <RecipeCard recipe={r} />)}
</div>
<p class="empty" data-empty hidden>Ninguna receta coincide. Prueba con otra categoría o etiqueta.</p>

<RecipeViewer open={open} />
<template
  data-recipe-view="templado"
  data-name="Templado de chocolate"
  data-eyebrow="Guía de técnica"
  data-color="#F2E3CE"
  data-paper={cabinet ? 'cabinet' : 'board'}
>
  {cabinet ? <CabinetGuide showTitle={false} /> : <TemperingGuide showTitle={false} />}
</template>
<template
  data-recipe-view="secretos"
  data-name={SECRETS.title}
  data-eyebrow="Cajón secreto"
  data-color="#F2E3CE"
  data-paper="cabinet"
>
  <SecretNotes />
</template>
{recipes.map((r) => (
  <template {...viewData(r)}>
    <RecipeSheet recipe={r} showTitle={false} />
  </template>
))}

<script>
  // Only the grid filters; the tempering board above it has its own pull tab.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] [data-recipe]')];
  const catButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  let cat = 'all';
  let tag: string | null = null;

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').split('|');
      const ok =
        (cat === 'all' || card.dataset.category === cat) &&
        (!tag || tags.includes(tag)) &&
        (!q || (card.dataset.search ?? '').includes(q));
      card.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'receta' : 'recetas'}`;
    if (empty) empty.hidden = shown > 0;
  }

  for (const b of catButtons) {
    b.addEventListener('click', () => {
      cat = b.dataset.cat ?? 'all';
      for (const o of catButtons) {
        const on = o === b;
        o.classList.toggle('on', on);
        o.setAttribute('aria-pressed', String(on));
      }
      apply();
    });
  }

  for (const b of tagButtons) {
    b.addEventListener('click', () => {
      const next = b.dataset.tag ?? null;
      tag = tag === next ? null : next;
      for (const o of tagButtons) {
        const on = o.dataset.tag === tag;
        o.classList.toggle('on', on);
        o.setAttribute('aria-pressed', String(on));
      }
      apply();
    });
  }

  search?.addEventListener('input', apply);
</script>

<style>
  .bar {
    max-width: 1120px;
    margin: 0 auto 18px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--tan);
  }
  .count { font: 500 13px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .sort { font: 400 13px/1 var(--sans); color: var(--tan-dark); }
  .grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 30px 26px;
    align-content: start;
  }
  .empty {
    max-width: 1120px;
    margin: 24px auto 0;
    text-align: center;
    font: 400 15px/1.5 var(--sans);
    color: var(--tan-dark);
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 22px; }
    .bar { margin-bottom: 14px; }
  }
</style>

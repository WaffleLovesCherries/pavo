---
/**
 * The secret notes full size: every note from src/config/secrets.json lying on the wood,
 * cloned into the viewer drawer from the index inside a `paper--cabinet` sheet, the way
 * the cabinet guide is.
 */
import { SECRETS } from '../config/secrets';
import Note from './Note.astro';
import SecretNote from './SecretNote.astro';

const TILTS = [-1.2, 0.8, -0.5, 1.3, -0.9, 0.6];
---
<div class="tray">
  <div class="drawer">
    {SECRETS.notes.map((n, i) => (
      <Note tilt={TILTS[i % TILTS.length]!}>
        <SecretNote note={n} />
      </Note>
    ))}
  </div>
</div>

<style>
  .tray { container-type: inline-size; }
  .drawer {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 30px 28px;
    align-items: start;
    padding: 10px 6px 8px;
  }
  @container (max-width: 460px) {
    .drawer { grid-template-columns: 1fr; gap: 24px; padding: 8px 2px 6px; }
  }
</style>

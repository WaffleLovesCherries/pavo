---
/**
 * Something lying in the cabinet drawer: a wrapper, an index card, a ticket.
 * A slight `tilt` in degrees and a tight shadow, as if dropped on the wood.
 * Whoever lays the notes out may slide one by setting `--dx` / `--dy` on it, turn it by
 * overriding `--tilt` (and `transform-origin`), and mark it `is-lifted` while it is being
 * carried; at rest the offset is zero and it lies where it was.
 */
interface Props {
  tilt?: number;
  class?: string;
}
const { tilt = 0, class: className = '' } = Astro.props;
---
<div class:list={['lying', className]} style={`--tilt:${tilt}deg`} data-note>
  <slot />
</div>

<style>
  .lying {
    position: relative;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--tilt));
    /*
     * The shadow is a box-shadow, not a filter: drop-shadow. Everything lying in a drawer is a
     * rectangle, so they look the same, but Safari does not repaint a filter's shadow properly
     * under an element whose transform changes every frame, and a dragged note left a trail of
     * stale shadows behind it. (A box-shadow blur is about twice a drop-shadow's radius.)
     */
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 5px 16px rgba(0, 0, 0, .28);
    transition: box-shadow .15s ease;
  }
  /* Picked up off the wood: the shadow falls further and softer. */
  .lying.is-lifted {
    box-shadow: 0 2px 4px rgba(0, 0, 0, .25), 0 14px 36px rgba(0, 0, 0, .32);
  }
  @media (prefers-reduced-motion: reduce) {
    .lying { transform: translate(var(--dx, 0px), var(--dy, 0px)); transition: none; }
  }
</style>

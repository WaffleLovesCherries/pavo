---
import { CATEGORIES } from '../config/categories';
import { EFFORT_LABELS } from '../config/site';
import Drawer from './Drawer.astro';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const iconNames = Object.keys(import.meta.glob('../icons/*.svg'))
  .map((p) => p.replace(/^.*\/(.+)\.svg$/, '$1'))
  .sort();
const levels = [1, 2, 3, 4, 5];
const meters = [
  { key: 'effort', label: 'Esfuerzo', required: true, hint: EFFORT_LABELS.slice(1).join(' · ') },
  { key: 'sweetness', label: 'Dulzor', required: true },
  { key: 'bitterness', label: 'Amargor', required: true },
  { key: 'intensity', label: 'Intensidad', required: false, hint: 'opcional' },
];
const first = CATEGORIES[0]!;
---
<div data-composer data-sprite={`${base}icons.svg`}>
<Drawer name="composer" eyebrow="Receta nueva" title="Inspírate" width="min(720px, 88vw)" paper="clean" closeLabel="Cerrar sin guardar">
    <form class="form" data-composer-form style={`--c:${first.color}`}>
      <label class="field">
        <span class="label-sm">Nombre</span>
        <input name="name" type="text" required autocomplete="off" placeholder="Ganache de praliné de avellana" data-first-field />
      </label>

      <fieldset class="field cats">
        <legend class="label-sm">Categoría</legend>
        <div class="pills">
          {CATEGORIES.map((c, i) => (
            <label class="pill" style={`--pc:${c.color}`}>
              <input type="radio" name="category" value={c.key} data-color={c.color} data-icon={c.icon} checked={i === 0} required />
              <Icon name={c.icon} size={18} class="pill-icon" />
              <span>{c.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="row">
        <label class="field">
          <span class="label-sm">Preparación</span>
          <input name="prep" type="text" required autocomplete="off" placeholder="25 min + 12 h de reposo" />
        </label>
        <label class="field">
          <span class="label-sm">Tipo <em>opcional</em></span>
          <input name="kind" type="text" autocomplete="off" placeholder="relleno, cobertura, glaseado…" />
        </label>
      </div>

      <div class="row">
        <label class="field">
          <span class="label-sm">Perfil</span>
          <input name="profile" type="text" required autocomplete="off" placeholder="Frutos secos, frutos rojos ácidos…" />
        </label>
        <label class="field">
          <span class="label-sm">Última vez</span>
          <input name="lastMade" type="date" data-today />
        </label>
      </div>

      <div class="meters">
        {meters.map((m) => (
          <div class="meter" role="group" aria-label={m.label} data-optional={m.required ? undefined : ''}>
            <span class="meter-label">{m.label}{m.hint && <em>{m.hint}</em>}</span>
            <div class="pips">
              {levels.map((i) => (
                <label class="pip" title={`${i} de 5`}>
                  <input type="radio" name={m.key} value={i} required={m.required} />
                  <span></span>
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="field pairs">
        <label class="label-sm" for="composer-pairs">Combina con</label>
        <input id="composer-pairs" name="pairs" type="range" min="0" max="100" value="50" />
        <div class="scale"><span>Negro</span><span>Con leche</span><span>Blanco</span></div>
      </div>

      <details class="field iconpick" data-iconpick>
        <summary>
          <span class="label-sm">Icono</span>
          <span class="icon preview" data-icon-preview><svg aria-hidden="true"></svg></span>
          <span class="preview-name" data-icon-name>Por defecto de la categoría</span>
          <svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5l3 3 3-3" /></svg>
        </summary>
        <div class="icons">
          <label class="ico ico-default" title="Por defecto de la categoría">
            <input type="radio" name="icon" value="" checked />
            <span class="ico-ring"></span>
          </label>
          {iconNames.map((n) => (
            <label class="ico" title={n}>
              <input type="radio" name="icon" value={n} />
              <span class="icon"><svg data-icon={n} aria-hidden="true"></svg></span>
            </label>
          ))}
        </div>
      </details>

      <label class="field">
        <span class="label-sm">Etiquetas <em>separadas por comas</em></span>
        <input name="tags" type="text" autocomplete="off" placeholder="avellana, praliné, bombón" />
      </label>

      <fieldset class="field ingredients" data-ingredients>
        <legend class="label-sm">Ingredientes <em>los iconos se deducen del nombre; pasa el ratón por una fila o toca su icono para elegir</em></legend>
        <div class="ing-rows" data-ingredient-rows></div>
        <button type="button" class="ing-add" data-ingredient-add>+ Añadir ingrediente</button>
      </fieldset>

      <label class="field">
        <span class="label-sm">Elaboración <em>Markdown</em></span>
        <textarea name="method" rows="8" placeholder={"1. Calienta la nata con el azúcar invertido a 80 °C.\n2. Viértela sobre la cobertura en tres veces, emulsionando entre cada adición."}></textarea>
      </label>

      <footer class="foot">
        <p class="hint">Descarga un archivo <code>.md</code>. Déjalo en <code>src/content/recipes/</code> y haz push.</p>
        <button type="submit" class="save">Guardar receta</button>
      </footer>
    </form>
</Drawer>
</div>

<template data-ingredient-template>
  <div class="ing-row">
    <div class="ing-line">
      <input name="ing-name" type="text" autocomplete="off" placeholder="Cobertura negra 64 %" aria-label="Ingrediente" />
      <input name="ing-amount" type="text" autocomplete="off" placeholder="180 g" aria-label="Cantidad" />
      <input type="hidden" name="ing-icon" value="" />
      <button type="button" class="ing-ico" data-ingredient-icon aria-label="Elegir un icono" aria-expanded="false"><span class="ico-ring"></span><span class="icon"><svg aria-hidden="true"></svg></span></button>
      <button type="button" class="ing-x" data-ingredient-remove aria-label="Quitar ingrediente">×</button>
    </div>
    <div class="ing-icons">
      <div class="ing-strip" role="group" aria-label="Icono">
        <button type="button" class="ico ico-default" title="Deducir del nombre" data-pick=""><span class="ico-ring"></span></button>
        {iconNames.map((n) => (
          <button type="button" class="ico" title={n} data-pick={n}>
            <span class="icon"><svg data-icon={n} aria-hidden="true"></svg></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</template>

<script>
  import { setupDrawer } from '../lib/drawer';
  import { buildRecipeMarkdown, slugify, type RecipeDraft } from '../lib/recipeMarkdown';
  import { guessIcon } from '../lib/iconMatch';

  const wrapEl = document.querySelector<HTMLElement>('[data-composer]');
  const rootEl = wrapEl?.querySelector<HTMLElement>('[data-drawer="composer"]');
  const formEl = rootEl?.querySelector<HTMLFormElement>('[data-composer-form]');

  if (wrapEl && rootEl && formEl) {
    const root = rootEl;
    const form = formEl;
    const sprite = wrapEl.dataset.sprite ?? '';
    const preview = root.querySelector<SVGElement>('[data-icon-preview] svg');
    const previewName = root.querySelector<HTMLElement>('[data-icon-name]');
    const rows = root.querySelector<HTMLElement>('[data-ingredient-rows]');
    const rowTemplate = document.querySelector<HTMLTemplateElement>('[data-ingredient-template]');
    let spriteLoaded = false;

    const checkedCategory = () => form.querySelector<HTMLInputElement>('input[name="category"]:checked');

    function refreshIcon() {
      const chosen = form.querySelector<HTMLInputElement>('input[name="icon"]:checked')?.value ?? '';
      const name = chosen || checkedCategory()?.dataset.icon || '';
      if (preview) preview.innerHTML = name ? `<use href="${sprite}#i-${name}"></use>` : '';
      if (previewName) previewName.textContent = chosen || 'Por defecto de la categoría';
    }

    const drawer = setupDrawer(root, {
      focus: () => form.querySelector<HTMLInputElement>('[data-first-field]'),
      onClose: () => document.dispatchEvent(new CustomEvent('recipe-composer:closed')),
    });

    // The sprite is only referenced once the drawer opens, so the page does not fetch it for nothing.
    function fillSprite(scope: ParentNode) {
      for (const svg of scope.querySelectorAll<SVGElement>('svg[data-icon]')) {
        svg.innerHTML = `<use href="${sprite}#i-${svg.dataset.icon}"></use>`;
      }
    }

    function open() {
      if (!spriteLoaded) {
        fillSprite(root);
        spriteLoaded = true;
      }
      const today = form.querySelector<HTMLInputElement>('[data-today]');
      if (today && !today.value) today.value = new Date().toISOString().slice(0, 10);
      refreshIcon();
      drawer.open();
    }

    document.addEventListener('recipe-composer:open', open);
    document.addEventListener('recipe-composer:close', drawer.close);

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'category' && t.dataset.color) form.style.setProperty('--c', t.dataset.color);
      if (t.name === 'category' || t.name === 'icon') refreshIcon();
    });

    form.addEventListener('click', (e) => {
      const r = e.target as HTMLInputElement;
      if (r.type !== 'radio' || !r.closest('[data-optional]')) return;
      const group = form.querySelectorAll<HTMLInputElement>(`input[name="${r.name}"]`);
      if (r.dataset.was === '1') {
        r.checked = false;
        r.dataset.was = '';
      } else {
        for (const o of group) o.dataset.was = '';
        r.dataset.was = '1';
      }
    });

    // Ingredient rows. Each row owns its icon strip, collapsed until the row is hovered or its icon clicked.
    const iconInput = (row: Element) => row.querySelector<HTMLInputElement>('input[name="ing-icon"]');

    function refreshRow(row: Element) {
      const chosen = iconInput(row)?.value ?? '';
      const name = row.querySelector<HTMLInputElement>('input[name="ing-name"]')?.value ?? '';
      const shown = chosen || guessIcon(name) || '';
      const svg = row.querySelector<SVGElement>('[data-ingredient-icon] svg');
      if (svg) svg.innerHTML = shown ? `<use href="${sprite}#i-${shown}"></use>` : '';
      row.classList.toggle('has-icon', Boolean(shown));
      row.classList.toggle('auto', !chosen && Boolean(shown));
      for (const b of row.querySelectorAll<HTMLElement>('[data-pick]')) {
        b.classList.toggle('picked', b.dataset.pick === chosen);
      }
    }

    function setRowIcon(row: Element, name: string) {
      const input = iconInput(row);
      if (input) input.value = name;
      refreshRow(row);
    }

    function setOpen(row: Element, open: boolean) {
      row.classList.toggle('open', open);
      row.querySelector('[data-ingredient-icon]')?.setAttribute('aria-expanded', String(open));
      if (open) row.querySelector('.picked')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    }

    function addRow(): HTMLElement | null {
      if (!rows || !rowTemplate) return null;
      const frag = rowTemplate.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('.ing-row');
      if (spriteLoaded) fillSprite(frag);
      rows.append(frag);
      return row;
    }

    function clearRows() {
      if (!rows) return;
      for (const row of rows.querySelectorAll('.ing-row')) {
        setRowIcon(row, '');
        setOpen(row, false);
      }
    }

    for (let i = 0; i < 3; i++) addRow();

    root.querySelector('[data-ingredient-add]')?.addEventListener('click', () => {
      addRow()?.querySelector('input')?.focus();
    });
    rows?.addEventListener('click', (e) => {
      const target = e.target as Element;
      const row = target.closest<HTMLElement>('.ing-row');
      if (!row) return;
      const pick = target.closest<HTMLElement>('[data-pick]');
      if (pick) {
        setRowIcon(row, pick.dataset.pick ?? '');
        setOpen(row, false);
        row.querySelector<HTMLElement>('[data-ingredient-icon]')?.focus();
        return;
      }
      if (target.closest('[data-ingredient-icon]')) {
        setOpen(row, !row.classList.contains('open'));
        return;
      }
      if (!target.closest('[data-ingredient-remove]')) return;
      if (rows.querySelectorAll('.ing-row').length > 1) row.remove();
      else {
        for (const i of row.querySelectorAll('input')) i.value = '';
        setRowIcon(row, '');
      }
    });
    rows?.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      const row = t.closest('.ing-row');
      if (t.name === 'ing-name' && row) refreshRow(row);
    });
    rows?.addEventListener('keydown', (e) => {
      const row = (e.target as Element).closest<HTMLElement>('.ing-row.open');
      if (e.key !== 'Escape' || !row) return;
      e.stopPropagation();
      setOpen(row, false);
      row.querySelector<HTMLElement>('[data-ingredient-icon]')?.focus();
    });

    function download(fileName: string, text: string) {
      const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown;charset=utf-8' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: fileName });
      document.body.append(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const str = (k: string) => String(fd.get(k) ?? '').trim();
      const num = (k: string) => Number(fd.get(k) ?? 0);
      const names = fd.getAll('ing-name').map(String);
      const amounts = fd.getAll('ing-amount').map(String);
      const icons = fd.getAll('ing-icon').map(String);

      const draft: RecipeDraft = {
        name: str('name'),
        category: str('category'),
        icon: str('icon') || undefined,
        kind: str('kind') || undefined,
        prep: str('prep'),
        effort: num('effort'),
        sweetness: num('sweetness'),
        bitterness: num('bitterness'),
        intensity: num('intensity') || undefined,
        profile: str('profile'),
        pairs: num('pairs'),
        tags: str('tags').split(',').map((t) => t.trim()).filter(Boolean),
        lastMade: str('lastMade') || undefined,
        ingredients: names.map((n, i) => [n, amounts[i] ?? '', icons[i] || undefined] as [string, string, string?]),
        method: str('method'),
      };

      download(`${slugify(draft.name)}.md`, buildRecipeMarkdown(draft));
      form.reset();
      clearRows();
      for (const r of form.querySelectorAll<HTMLInputElement>('[data-optional] input')) r.dataset.was = '';
      form.style.setProperty('--c', checkedCategory()?.dataset.color ?? '');
      drawer.close();
    });
  }
</script>

<style>
  .form {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 26px 36px 0 calc(36px + var(--paper-left, 0px));
    overflow-y: auto;
  }
  .form fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .form legend { padding: 0; }

  .field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .field em {
    font-style: normal;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: none;
    color: var(--sand-dark);
    margin-left: 6px;
  }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .form input[type="text"],
  .form input[type="date"],
  .form textarea {
    width: 100%;
    border: 1px solid var(--sand-dark);
    background: var(--cream-lighter);
    border-radius: 10px;
    padding: 10px 12px;
    font: 400 14px/1.4 var(--sans);
    color: var(--ink);
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .form textarea { resize: vertical; font-family: var(--serif); font-size: 15px; line-height: 1.55; }
  .form input::placeholder, .form textarea::placeholder { color: var(--sand-dark); }
  .form input:focus, .form textarea:focus {
    outline: 0;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(169, 113, 63, .18);
  }

  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font: 600 12px/1 var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 9px 12px;
    border-radius: 10px;
    border: 1px solid var(--pc);
    color: var(--pc);
    transition: background .15s ease, color .15s ease;
  }
  .pill input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .pill :global(.pill-icon) { flex: none; }
  .pill:hover { filter: brightness(1.08); }
  .pill:has(input:checked) { background: var(--pc); color: var(--cream-light); }
  .pill:has(input:focus-visible) { box-shadow: 0 0 0 3px rgba(169, 113, 63, .25); }

  .meters { display: flex; flex-direction: column; gap: 12px; }
  .meter { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; }
  .meter-label { font: 500 12px/1.2 var(--sans); color: var(--muted-dark); }
  .meter-label em { display: block; font-style: normal; font-size: 10px; color: var(--sand-dark); margin-top: 3px; letter-spacing: .02em; }
  .pips { display: flex; gap: 5px; }
  .pip { position: relative; flex: 1; height: 22px; display: flex; align-items: center; cursor: pointer; }
  .pip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .pip span {
    flex: 1;
    height: 9px;
    border-radius: 9px;
    border: 1px solid var(--c);
    background: transparent;
    transition: background .12s ease, opacity .12s ease;
  }
  .pip:has(input:checked) span,
  .pip:has(~ .pip input:checked) span { background: var(--c); }
  .pips:hover .pip span { opacity: .55; }
  .pips:hover .pip:hover span,
  .pips:hover .pip:has(~ .pip:hover) span { background: var(--c); opacity: 1; }
  .pip:has(input:focus-visible) span { box-shadow: 0 0 0 3px rgba(169, 113, 63, .25); }

  .pairs input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 10px;
    margin: 6px 0;
    border-radius: 5px;
    border: 1px solid var(--sand-dark);
    background: linear-gradient(90deg,
      var(--panel) 0%, var(--panel) 33%,
      var(--pair-mid) 33%, var(--pair-mid) 66%,
      var(--pair-light) 66%, var(--pair-light) 100%);
    cursor: pointer;
  }
  .pairs input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--cream-light);
    border: 2px solid var(--ink-mid);
  }
  .pairs input[type="range"]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cream-light);
    border: 2px solid var(--ink-mid);
  }
  .pairs input[type="range"]:focus-visible { outline: 0; box-shadow: 0 0 0 3px rgba(169, 113, 63, .25); }
  .scale {
    display: flex;
    justify-content: space-between;
    font: 500 10px/1 var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .iconpick summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid var(--sand-dark);
    border-radius: 10px;
    background: var(--cream-lighter);
  }
  .iconpick summary::-webkit-details-marker { display: none; }
  .iconpick summary .label-sm { min-width: 40px; }
  .preview { width: 30px; height: 30px; color: var(--c); }
  .preview svg { width: 100%; height: 100%; fill: currentColor; }
  .preview-name { flex: 1; font: 400 14px/1 var(--sans); color: var(--ink); }
  .chev { color: var(--muted); transition: transform .2s ease; }
  .iconpick[open] .chev { transform: rotate(180deg); }
  .icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
    gap: 6px;
    margin-top: 10px;
    padding: 10px;
    max-height: 220px;
    overflow-y: auto;
    border: 1px solid var(--sand);
    border-radius: 10px;
    background: var(--cream-lighter);
  }
  .ico {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid transparent;
    color: var(--brown);
    cursor: pointer;
    transition: border-color .12s ease, background .12s ease;
  }
  .ico input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .ico .icon { width: 26px; height: 26px; }
  .ico .icon svg { width: 100%; height: 100%; fill: currentColor; }
  .ico-ring { width: 18px; height: 18px; border: 1.5px dashed currentColor; border-radius: 50%; }
  .ico:hover { border-color: var(--sand-dark); }
  .ico:has(input:checked) { border-color: var(--c); background: var(--cream-light); color: var(--c); }
  .ico:has(input:focus-visible) { box-shadow: 0 0 0 3px rgba(169, 113, 63, .25); }

  .ing-rows { display: flex; flex-direction: column; gap: 8px; }
  .ing-row { display: flex; flex-direction: column; }
  .ing-line { display: grid; grid-template-columns: 1fr 110px 30px 30px; gap: 8px; align-items: center; }
  .ing-ico {
    position: relative;
    width: 30px;
    height: 30px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--sand-dark);
    cursor: pointer;
    transition: border-color .12s ease, color .12s ease;
  }
  .ing-ico .ico-ring { width: 14px; height: 14px; border: 1.5px dashed currentColor; border-radius: 50%; }
  .ing-ico .icon { display: none; width: 22px; height: 22px; }
  .ing-ico .icon svg { width: 100%; height: 100%; fill: currentColor; }
  .ing-row.has-icon .ing-ico .ico-ring { display: none; }
  .ing-row.has-icon .ing-ico .icon { display: block; }
  .ing-row.has-icon .ing-ico { color: var(--c); }
  /* A guessed icon is drawn faintly, a chosen one in the category colour. */
  .ing-row.auto .ing-ico { color: var(--c); opacity: .45; }
  .ing-ico:hover, .ing-row.open .ing-ico { border-color: var(--sand-dark); opacity: 1; }
  .ing-ico:focus-visible { outline: 0; box-shadow: 0 0 0 3px rgba(169, 113, 63, .25); }

  .ing-icons {
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    transition: max-height .18s ease, margin-top .18s ease;
  }
  .ing-row.open .ing-icons,
  .ing-icons:has(:focus-visible) { max-height: 110px; margin-top: 6px; }
  @media (hover: hover) {
    .ing-row:hover .ing-icons { max-height: 110px; margin-top: 6px; }
  }

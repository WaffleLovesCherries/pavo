---
/**
 * The drawer a recipe (or the tempering guide, or the secret notes) opens in over the
 * index. Anything with `data-recipe="<id>"` opens the `<template data-recipe-view="<id>">`
 * of the same id; a link also pushes its URL, so the address bar and the back button
 * follow. `open` is an id to show as the page loads: a recipe's own URL renders the index
 * with its drawer already out, and closing it puts the index's URL back.
 */
import Drawer from './Drawer.astro';
import { SITE } from '../config/site';

interface Props {
  open?: string;
}
const { open } = Astro.props;
---
<Drawer name="viewer" width="min(1040px, 88vw)" closeLabel="Cerrar receta">
  <div class="view" data-recipe-view-body data-open={open} data-site-title={SITE.title}></div>
</Drawer>

<script>
  import { setupDrawer } from '../lib/drawer';

  const rootEl = document.querySelector<HTMLElement>('[data-drawer="viewer"]');
  const sheetEl = rootEl?.querySelector<HTMLElement>('[data-drawer-sheet]');
  const bodyEl = rootEl?.querySelector<HTMLElement>('[data-recipe-view-body]');
  const eyebrowEl = rootEl?.querySelector<HTMLElement>('[data-drawer-eyebrow]');
  const titleEl = rootEl?.querySelector<HTMLElement>('[data-drawer-title]');

  if (rootEl && sheetEl && bodyEl && eyebrowEl && titleEl) {
    const [root, sheet, body, eyebrow, title] = [rootEl, sheetEl, bodyEl, eyebrowEl, titleEl];
    const siteTitle = body.dataset.siteTitle ?? document.title;
    const drawer = setupDrawer(root, {
      focus: () => root.querySelector<HTMLElement>('button[data-drawer-close]'),
      onClose: () => {
        document.title = siteTitle;
        // Landed on the recipe's own URL: there is no page to go back to, so the address is swapped for the index's.
        if (history.state?.landed) history.replaceState(null, '', import.meta.env.BASE_URL);
        else if (history.state?.recipe) history.back();
      },
    });

    function show(id: string): boolean {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-recipe-view="${CSS.escape(id)}"]`);
      if (!tpl) return false;
      const { name = '', eyebrow: eb = '', color = '', paper = 'clean' } = tpl.dataset;

      body.replaceChildren(tpl.content.cloneNode(true));
      body.scrollTop = 0;
      eyebrow.textContent = eb;
      title.textContent = name;
      sheet.style.setProperty('--c', color);
      for (const c of [...sheet.classList]) if (c.startsWith('paper--')) sheet.classList.remove(c);
      sheet.classList.add(`paper--${paper}`);
      document.title = `${name} · ${siteTitle}`;
      drawer.open();
      return true;
    }

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const card = (e.target as Element).closest<HTMLElement>('[data-recipe]');
      const id = card?.dataset.recipe;
      if (!card || !id) return;
      if (!show(id)) return;
      e.preventDefault();
      // Only a link has an address of its own to show; the rest open in place.
      if (card instanceof HTMLAnchorElement) history.pushState({ recipe: id }, '', card.href);
    });

    window.addEventListener('popstate', (e) => {
      const id = e.state?.recipe;
      if (typeof id === 'string') show(id);
      else drawer.close();
    });

    const landed = body.dataset.open;
    if (landed && show(landed)) history.replaceState({ recipe: landed, landed: true }, '', location.href);
  }
</script>

<style>
  .view {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 30px 36px 52px calc(36px + var(--paper-left, 0px));
  }
  @media (max-width: 720px) {
    .view { padding: 18px 16px 32px calc(16px + var(--paper-left, 0px)); overscroll-behavior: contain; }
  }
</style>

---
/**
 * One chocolate's tempering curve, drawn in chalk: temperature against time,
 * room temperature → melted → cooled → working, with each range as a faint band
 * and its numbers written above. `compact` is the small version on the index card.
 */
import type { Chocolate } from '../config/tempering';
import { TEMP_AXIS } from '../config/tempering';
import { checkChocolate, curvePath, formatRange, mid, plateaus, scaleX, scaleY, ticks, type Frame } from '../lib/tempering';

interface Props {
  chocolate: Chocolate;
  compact?: boolean;
  /** Wobble the line like chalk; off for printed ink. */
  rough?: boolean;
  /** The line colour; defaults to the ink so a printed wrapper is one colour. */
  series?: string;
}
const { chocolate: c, compact = false, rough = false, series = 'var(--plot-ink)' } = Astro.props;

const errors = checkChocolate(c);
if (errors.length) throw new Error(`src/config/tempering.ts: ${errors.join('; ')}`);

const frame: Frame = compact
  ? { width: 160, height: 84, top: 18, right: 8, bottom: 6, left: 6 }
  : { width: 320, height: 200, top: 22, right: 16, bottom: 30, left: 36 };

const STAGE_LABEL = { melt: 'fundir', cool: 'enfriar', work: 'trabajar' } as const;

const path = curvePath(c, frame);
const bands = plateaus(c).map((p) => {
  const x0 = scaleX(p.from, frame);
  const x1 = scaleX(p.to, frame);
  const yHi = scaleY(p.range[1], frame);
  const yLo = scaleY(p.range[0], frame);
  return {
    stage: p.stage,
    x: x0,
    w: x1 - x0,
    y: yHi,
    h: Math.max(yLo - yHi, 3),
    cx: (x0 + x1) / 2,
    labelY: yHi - 7,
    text: `${formatRange(p.range)}°`,
  };
});
const end = { x: scaleX(1, frame), y: scaleY(mid(c.work), frame) };
const baseline = scaleY(TEMP_AXIS[0], frame);
const filterId = `chalk-${c.key}${compact ? '-s' : ''}`;
const summary = `${c.name}: fundir a ${formatRange(c.melt)} °C, enfriar a ${formatRange(c.cool)} °C y trabajar a ${formatRange(c.work)} °C.`;
---
<svg
  class:list={['chart', { compact }]}
  viewBox={`0 0 ${frame.width} ${frame.height}`}
  role="img"
  aria-label={summary}
  style={`--series:${series}`}
>
  {rough && (
    <defs>
      <filter id={filterId} x="-4%" y="-8%" width="108%" height="116%">
        <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale={compact ? 1.2 : 1.8} xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
  )}

  {!compact && (
    <g class="grid">
      {ticks(10).map((t) => (
        <>
          <line x1={frame.left} x2={frame.width - frame.right} y1={scaleY(t, frame)} y2={scaleY(t, frame)} />
          <text class="tick" x={frame.left - 6} y={scaleY(t, frame)}>{t}°</text>
        </>
      ))}
    </g>
  )}

  {bands.map((b) => (
    <rect class="band" x={b.x} y={b.y} width={b.w} height={b.h} rx="1.5" />
  ))}

  <path class="curve" d={path} filter={rough ? `url(#${filterId})` : undefined} />
  <circle class="end" cx={end.x} cy={end.y} r={compact ? 3 : 4} />

  {bands.map((b) => (
    <text class="value" x={b.cx} y={b.labelY}>{b.text}</text>
  ))}
  {!compact && bands.map((b) => (
    <text class="stage" x={b.cx} y={baseline + 16}>{STAGE_LABEL[b.stage]}</text>
  ))}
</svg>

<style>
  /* Colours come from the sheet the chart is printed on:
     --plot-ink, --plot-ink-dim, --plot-grid, --plot-surface, --plot-font (see paper.css). */
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .grid line { stroke: var(--plot-grid); stroke-width: 1; }
  .tick {
    fill: var(--plot-ink-dim);
    font: 500 11px var(--plot-font);
    text-anchor: end;
    dominant-baseline: middle;
  }
  .band { fill: var(--series); opacity: .16; }
  .curve {
    fill: none;
    stroke: var(--series);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .95;
  }
  .end { fill: var(--series); stroke: var(--plot-surface); stroke-width: 2; }
  .value {
    fill: var(--plot-ink);
    font: 600 14px var(--plot-font);
    text-anchor: middle;
    letter-spacing: .02em;
  }
  .stage {
    fill: var(--plot-ink-dim);
    font: 500 12px var(--plot-font);
    text-anchor: middle;
  }
  .compact .value { font-size: 12px; }
  .compact .curve { stroke-width: 2; }
</style>

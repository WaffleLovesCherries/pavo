---
/**
 * The tempering guide's place in the index grid: a chalkboard hung across the top
 * with the six curves in miniature. It opens in the viewer like a recipe card and
 * links to /templado/.
 */
import { CHOCOLATES } from '../config/tempering';
import ChalkTray from './ChalkTray.astro';
import TemperingChart from './TemperingChart.astro';

const href = `${import.meta.env.BASE_URL}templado/`;
---
<a
  class="board paper paper--board"
  href={href}
  data-recipe="templado"
>
  <div class="face paper-face">
    <div class="intro">
      <p class="kicker">Guía de técnica</p>
      <h2>Templado de chocolate</h2>
      <p class="sub">Las curvas de cada chocolate, de fundir a trabajar.</p>
    </div>
    <ul class="minis">
      {CHOCOLATES.map((c) => (
        <li>
          <TemperingChart chocolate={c} series={c.chalk} compact rough />
          <span class="name">{c.name}</span>
        </li>
      ))}
    </ul>
  </div>
  <ChalkTray colors={CHOCOLATES.slice(0, 3).map((c) => c.chalk)} />
</a>

<style>
  .board { display: block; color: var(--chalk); }
  .board:hover { color: var(--chalk); }
  .board:focus-visible { outline: 2px dashed var(--accent-light); outline-offset: 6px; }

  .face {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 3fr);
    gap: 18px 32px;
    align-items: center;
    padding: 22px 26px 20px;
  }
  .intro { display: flex; flex-direction: column; gap: 4px; }
  .kicker { margin: 0; font: 500 16px/1 var(--chalk-font); color: var(--chalk-dim); }
  .intro h2 { margin: 0; font: 600 34px/1.05 var(--chalk-font); color: var(--chalk); }
  .sub { margin: 4px 0 0; font: 400 17px/1.3 var(--chalk-font); color: var(--chalk-dim); }

  .minis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px 14px;
  }
  .minis li { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font: 500 15px/1.1 var(--chalk-font); color: var(--chalk); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 1000px) {
    .face { grid-template-columns: 1fr; gap: 14px; }
    .minis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .face { padding: 18px 18px 16px; }
    .intro h2 { font-size: 30px; }
    .minis { gap: 8px 12px; }
  }
  @media (max-width: 420px) {
    .minis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

---
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;

const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found in src/icons`);
---
<span class:list={['icon', className]} style={`width:${size}px;height:${size}px`} set:html={svg} aria-hidden="true" />

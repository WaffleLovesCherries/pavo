---
/**
 * The secret drawer, as it slides out from under the header once the keyhole has been
 * unlocked (src/components/TemperingDrop.astro swaps it in for the cabinet card): the
 * notes from src/config/secrets.json in miniature, lying strewn on the wood and pushed
 * around like the wrappers (src/lib/strew.ts). Clicking the drawer opens the notes full
 * size in the viewer, like a recipe; there is no page of their own.
 */
import { SECRETS } from '../config/secrets';
import Note from './Note.astro';
import SecretNote from './SecretNote.astro';

/** How the notes lie before the script strews them (and without it): in a grid, barely tilted. */
const TILTS = [1.1, -1.4, 0.7, -0.9, 1.5, -0.6];
---
<div class="drawer paper paper--cabinet" role="button" tabindex="0" aria-label={`${SECRETS.title}: abrir las notas`} data-recipe="secretos" data-secret-card>
  <div class="face paper-face" data-floor>
    <ul class="minis">
      {SECRETS.notes.map((n, i) => (
        <li>
          <Note tilt={TILTS[i % TILTS.length]!}>
            <SecretNote note={n} compact />
          </Note>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { strew } from '../lib/strew';

  const card = document.querySelector<HTMLElement>('[data-secret-card]');
  const floor = card?.querySelector<HTMLElement>('[data-floor]');
  if (card && floor) {
    strew(card, floor);
    // Not a link, so the keyboard opens it by hand.
    card.addEventListener('keydown', (e) => {
      if (e.target !== card || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      card.click();
    });
  }
</script>

<style>
  .drawer { display: block; color: var(--ink); cursor: pointer; }
  .drawer:focus-visible { outline: 2px dashed var(--accent-light); outline-offset: 6px; }
  .drawer :global([data-note]) { cursor: grab; user-select: none; touch-action: none; }
  .drawer.is-dragging, .drawer.is-dragging :global([data-note]) { cursor: grabbing; }

  .face { padding: 28px 28px 26px; }
  .minis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    gap: 16px 18px;
  }
  .minis li { min-width: 0; }

  @media (max-width: 720px) {
    .face { padding: 22px 20px 20px; }
    .minis { grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 14px 12px; }
  }
</style>
